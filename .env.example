# Copy this file to .env.local and fill in the password.
# .env.local is ignored by git, so the password never gets uploaded.

# Hostinger mailbox used to send the contact form emails
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@mges49.com
SMTP_PASS=

# Where contact form messages are delivered (defaults to SMTP_USER)
CONTACT_TO=info@mges49.com

# Public address of the website, used for links inside the emails
SITE_URL=http://localhost:3000
